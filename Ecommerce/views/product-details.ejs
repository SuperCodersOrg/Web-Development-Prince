
<%- include('partials/head', { title: product.name }) %>
<%- include('partials/header') %>

<main class="max-w-5xl mx-auto px-5 py-10">

  <a href="/products" class="text-gray-600 hover:text-gray-900">
    ← Back to Products
  </a>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">

    <div>
      <% if (product.image) { %>
        <img src="<%= product.image %>"
             alt="<%= product.name %>"
             class="w-full h-80 object-contain bg-gray-50 border rounded">
      <% } %>
    </div>

    <div>
      <h1 class="text-3xl font-bold"><%= product.name %></h1>

      <p class="text-gray-500 mt-2"><%= product.category %></p>

      <p class="text-2xl font-bold mt-4">
        ₹<%= product.price.toLocaleString('en-IN') %>
      </p>

      <p class="text-gray-700 mt-5">
        <%= product.description %>
      </p>

      <p class="mt-5">
        Stock: <%= product.stock %>
      </p>

      <button type="button"
              class="mt-6 bg-gray-900 text-white px-6 py-3 rounded">
        Add to Cart
      </button>
    </div>

  </div>
</main>

<%- include('partials/footer') %>
