
<!DOCTYPE html>
<html>

<head>
    <title>Add Student</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen flex flex-col">

    <%- include("header") %>

    <div class="max-w-xl mx-auto w-full p-6 flex-1">

        <h1 class="text-3xl font-bold mb-6">
            Add Student
        </h1>

        <form action="/add-student" method="POST"
            class="bg-white p-6 rounded-lg shadow">

            <div class="mb-4">

                <label class="block font-semibold mb-2">
                    Student Name
                </label>

                <input
                    type="text"
                    name="name"
                    placeholder="Enter student name"
                    required
                    class="w-full border border-gray-300 p-2 rounded"
                >

            </div>

            <div class="mb-4">

                <label class="block font-semibold mb-2">
                    Marks
                </label>

                <input
                    type="number"
                    name="marks"
                    placeholder="Enter marks"
                    min="0"
                    max="100"
                    required
                    class="w-full border border-gray-300 p-2 rounded"
                >

            </div>

            <button
                type="submit"
                class="w-full bg-[#82b0fa] text-white p-2 rounded hover:bg-gray-800"
            >
                Add Student
            </button>

        </form>

    </div>

    <%- include("footer") %>

</body>

</html>